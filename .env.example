# ---------------------------------------------------------------------------
# Vision LLM backend: ollama (local, default) | gemini | openai | anthropic
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
# Optional: override the provider's default model
#   ollama: llava   gemini: gemini-3.5-flash-lite   openai: gpt-4.1-mini   anthropic: claude-haiku-5-5
# LLM_MODEL=

# Only the key for the provider you use is needed. Never commit .env.
# Gemini (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Database for the REST API (api/). Defaults to a local SQLite file if unset.
# DATABASE_URL=postgresql+psycopg://invoice:invoice@localhost:5432/invoices
DATABASE_URL=sqlite:///./invoices.db
